# Credencial apenas de desenvolvimento local. Em outro ambiente, defina uma senha própria.
DB_PASSWORD=lab3_local
DB_PORT=5432
DB_URL=jdbc:postgresql://127.0.0.1:5432/moeda_estudantil

# Backend executado pelo scripts/dev.ps1. Ajuste para usar SMTP externo.
SERVER_PORT=8080
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_FROM=moedas@localhost
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025

# Vazio seleciona .local/institucional.json, preparado pela ação ambiente.
# Para cadastros reais, informe o caminho de um JSON externo ao repositório.
INSTITUCIONAL_ARQUIVO=

# Destino do proxy de /api no servidor de desenvolvimento Vite.
VITE_API_TARGET=http://127.0.0.1:8080
