@startuml
title Modelo ER — Sistema de Moeda Estudantil
hide circle
skinparam linetype ortho
skinparam shadowing false
skinparam class {
  BackgroundColor #FFFFFF
  BackgroundColor<<planejada>> #F2F3F5
  BorderColor #194E45
  BorderColor<<planejada>> #868B94
}

entity "instituicao" as instituicao {
  * id : bigint <<PK>>
  --
  * nome : varchar(150) <<UQ>>
}
entity "usuario" as usuario {
  * id : uuid <<PK>>
  --
  * login : varchar(80) <<UQ>>
  * senha_hash : varchar(100)
  * perfil : varchar(20)
  * ativo : boolean
  * criado_em : timestamptz
}
entity "aluno" as aluno {
  * id : uuid <<PK, FK usuario>>
  --
  * nome : varchar(150)
  * email : varchar(254)
  * cpf : varchar(11) <<UQ>>
  * rg : varchar(30)
  * endereco : varchar(300)
  * curso : varchar(150)
  * instituicao_id : bigint <<FK>>
}
entity "empresa_parceira" as empresa {
  * id : uuid <<PK, FK usuario>>
  --
  * nome : varchar(150)
  * email : varchar(254)
}
entity "conta" as conta {
  * id : uuid <<PK>>
  --
  * titular_id : uuid <<FK usuario, UQ>>
  * saldo : bigint
  * versao : bigint
}
entity "departamento" as departamento <<planejada>> {
  * id : uuid <<PK>>
  --
  * nome : varchar
  * instituicao_id : bigint <<FK>>
}
entity "professor" as professor <<planejada>> {
  * id : uuid <<PK, FK usuario>>
  --
  * nome : varchar
  * cpf : varchar <<UQ>>
  * instituicao_id : bigint <<FK>>
  * departamento_id : uuid <<FK>>
}
entity "semestre" as semestre <<planejada>> {
  * id : uuid <<PK>>
  --
  * ano : integer
  * numero : integer
  UNIQUE (ano, numero)
}
entity "movimentacao" as movimentacao <<planejada>> {
  * id : uuid <<PK>>
  --
  * tipo : varchar
  * quantidade : bigint
  * ocorrida_em : timestamptz
  origem_id : uuid <<FK conta>>
  destino_id : uuid <<FK conta>>
}
entity "reconhecimento" as reconhecimento <<planejada>> {
  * id : uuid <<PK, FK movimentacao>>
  --
  * motivo : text
}
entity "credito_semestral" as credito <<planejada>> {
  * id : uuid <<PK, FK movimentacao>>
  --
  * professor_id : uuid <<FK>>
  * semestre_id : uuid <<FK>>
  UNIQUE (professor_id, semestre_id)
}
entity "vantagem" as vantagem <<planejada>> {
  * id : uuid <<PK>>
  --
  * empresa_id : uuid <<FK>>
  * descricao : text
  * foto_url : varchar
  * custo : bigint
  * ativa : boolean
}
entity "resgate" as resgate <<planejada>> {
  * id : uuid <<PK, FK movimentacao>>
  --
  * vantagem_id : uuid <<FK>>
  * custo_debitado : bigint
}
entity "cupom" as cupom <<planejada>> {
  * id : uuid <<PK>>
  --
  * resgate_id : uuid <<FK, UQ>>
  * codigo : varchar <<UQ>>
  * gerado_em : timestamptz
}
entity "notificacao" as notificacao <<planejada>> {
  * id : uuid <<PK>>
  --
  * movimentacao_id : uuid <<FK>>
  * destinatario : varchar
  * assunto : varchar
  * conteudo : text
  * estado : varchar
  * tentativas : integer
}

instituicao ||--o{ aluno
usuario ||--o| aluno
usuario ||--o| empresa
usuario ||--o| conta
instituicao ||--o{ departamento
instituicao ||--o{ professor
departamento ||--o{ professor
usuario ||--o| professor
conta |o--o{ movimentacao : origem
conta |o--o{ movimentacao : destino
movimentacao ||--o| reconhecimento
movimentacao ||--o| credito
movimentacao ||--o| resgate
professor ||--o{ credito
semestre ||--o{ credito
empresa ||--o{ vantagem
vantagem ||--o{ resgate
resgate ||--|| cupom
movimentacao ||--o{ notificacao

note bottom of usuario
  Um único perfil por usuário.
  Aluno e professor: uma conta cada.
  Empresa: nenhuma conta.
  Exclusão lógica: ativo = false.
end note
note bottom of movimentacao
  Subtipos exclusivos conforme tipo.
  Reconhecimento: origem e destino obrigatórios.
  Crédito semestral: apenas destino.
  Resgate: apenas origem.
  Quantidade e custo positivos; saldo não negativo.
end note
note bottom of professor
  Departamento deve pertencer
  à instituição do professor.
end note
legend bottom
  Branco: esquema implementado nas migrações da fase 2.
  Cinza <<planejada>>: modelo das próximas funções; sem tabelas criadas ainda.
  * Campo obrigatório. PK: chave primária. FK: chave estrangeira. UQ: único.
endlegend
@enduml
