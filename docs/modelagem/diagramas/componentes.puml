@startuml
left to right direction
skinparam backgroundColor #FFFFFF
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam shadowing false
skinparam roundcorner 10
skinparam ArrowColor #475569
skinparam componentStyle uml2
skinparam componentBackgroundColor #EFF6FF
skinparam componentBorderColor #2563EB
skinparam packageStyle rectangle
skinparam packageBorderColor #94A3B8
title Sistema de Moeda Estudantil\nComponentes lógicos e MVC — implementação atual

package "Aplicação" {
  package "View" {
    component "V01\nInterface React/TypeScript" as WebViews
  }
  package "Controller" {
    component "C01\nControllers HTTP + DTOs\nBean Validation" as Controllers
    component "M01\nSpring Security\nSessão + CSRF" as Auth
  }
  package "Model / services transacionais" {
    component "M02\nCadastros e catálogo" as Catalog
    component "M03\nMoedas e histórico\nReconhecimento / resgate / crédito" as Coins
    component "M04\nNotificações persistidas\nWorker de tentativas" as Notifications
  }
  package "Infraestrutura" {
    component "P01\nSpring Data JPA / Hibernate\nFlyway" as Persistence
    component "E01\nJavaMailSender\nAdaptador SMTP" as EmailAdapter
    component "T01\nCrédito interno\nStartup + janeiro/julho" as Scheduler
    component "I01\nPré-cadastro institucional\nINSTITUCIONAL_ARQUIVO" as Institutional
  }
}
database "PostgreSQL" as Database #F0FDF4
component "SMTP\nMailpit local / provedor externo" as Provider #F0FDF4
artifact "JSON institucional externo" as Input #FFF7ED

WebViews --> Controllers : HTTP / JSON / fotos
Controllers ..> Auth : sessão e perfil
Controllers --> Catalog
Controllers --> Coins
Auth --> Persistence : credenciais
Catalog --> Persistence
Coins --> Persistence : locks + saldos + movimentação
Coins --> Notifications : grava intenção na mesma transação
Notifications --> Persistence : confirmadas + tentativas
Notifications --> EmailAdapter
EmailAdapter --> Provider : SMTP após commit
Persistence --> Database
Scheduler --> Coins : execução interna idempotente
Institutional --> Catalog : dados iniciais
Input --> Institutional

note bottom of Coins
  Services validam autorização e regras.
  Conta(s), movimentação e notificações:
  uma transação de banco.
  Repetição SMTP não chama moedas.
end note
legend bottom
  Módulos lógicos da mesma aplicação; setas são dependências, não interfaces Java.
  Agendador é bean interno sob identidade do processo, sem ator administrativo ou endpoint público.
  Banco é definido por Flyway; Hibernate apenas valida. API usa DTOs, nunca entidades.
endlegend
@enduml
